# docker/.env.example
#
# docker-compose.yml reads its Postgres credentials from docker/.env
# (see the `env_file: - .env` entry under the `postgres` service).
# Copy this file to docker/.env and fill in real values before running
# `docker-compose up -d`. docker/.env is gitignored and must never be committed.

DB_USER=law7
DB_PASSWORD=change_me
DB_NAME=law7
